# Copy this file to dev.tfvars and customize the values

# Project configuration
project_name = "my-app-host"
region       = "us-east-1"

# EC2 configuration
instance_type = "t2.micro"

# SSH access - Get your public IP with: curl -s https://checkip.amazonaws.com
ssh_ingress_cidr = "43.251.253.168/32"  # e.g., "203.0.113.1/32"
public_key_path  = "~/.ssh/id_ed25519.pub"

# S3 configuration
create_s3      = true
s3_bucket_name = ""  # Leave empty for auto-generated name

# CloudFront configuration (requires create_s3=true)
create_cloudfront = false

# ECR configuration
create_ecr = true

# Domain configuration (optional - used later with Caddy for auto-TLS)
domain_name = ""  # e.g., "app.example.com"

# Tags
tags = {
  Project     = "my-app-host"
  Environment = "production"
  Owner       = "haroon"
  CostCenter  = "engineering"
}
